<?xml version="1.0" encoding="utf-8"?>
<!--
    On Android 12+ (API 31+), android:allowBackup="false" is ignored and these
    rules govern cloud-backup and device-transfer behaviour instead.
    Exclude all app data to match the intended allowBackup="false" policy.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
