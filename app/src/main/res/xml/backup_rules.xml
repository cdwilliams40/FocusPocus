<?xml version="1.0" encoding="utf-8"?><!--
    Cloud-backup rules for API 29-30. On API 31+ the equivalent policy lives in
    data_extraction_rules.xml instead.

    android:allowBackup="false" already disables backup on these API levels, so
    this file is belt-and-braces: if allowBackup is ever flipped on, nothing
    should leave the device implicitly. Backup and restore go through the
    explicit Grimoire export/import (BackupCodec), which deliberately omits live
    enforcement state so a restore can never resurrect a stale seal.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
