<?xml version="1.0" encoding="utf-8"?>
<!-- No legacy admin policies needed: everything FocusPocus does (package
     suspension, uninstall blocking) comes from device-owner status, which is
     granted via `dpm set-device-owner`, not from <uses-policies>. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies />
</device-admin>
