    <string name="settings_device_owner">Warden Mode (Device Owner)</string>
    <string name="settings_device_owner_suspend">Grey Out Blocked Apps</string>
    <string name="settings_device_owner_suspend_desc">Suspend blocked apps at the system level during focus sessions — their icons grey out in the launcher and they can\'t be opened at all</string>
    <string name="settings_device_owner_suspend_pacts">Grey Out Well Apps</string>
    <string name="settings_device_owner_suspend_pacts_desc">Keep Well apps suspended while no pact runs — greyed out, absent from launcher suggestions, and openable by requesting time on the Well tab</string>
    <string name="settings_device_owner_active">FocusPocus is this device\'s owner. It cannot be uninstalled while Warden Mode is active.</string>
    <string name="settings_device_owner_inactive_desc">Make FocusPocus the device owner to grey out blocked apps system-wide and prevent the app from being uninstalled in a moment of weakness. One-time setup from a computer with adb:</string>
    <string name="settings_device_owner_step1">Temporarily remove all accounts from this phone (Settings → Passwords &amp; accounts). You can add every one of them back as soon as setup is done.</string>
    <string name="settings_device_owner_step2">Enable USB debugging (Settings → Developer options) and connect the phone to a computer with adb.</string>
    <string name="settings_device_owner_step3">Run this command on the computer:</string>
    <string name="settings_device_owner_copy_command">Copy command</string>
    <string name="settings_device_owner_copied">Command copied</string>
    <string name="settings_device_owner_check_status">I ran the command — check status</string>
    <string name="settings_device_owner_not_detected">Warden Mode isn\'t active yet. If the command printed an error, the troubleshooting tips below cover the most common one.</string>
    <string name="settings_device_owner_troubleshoot_title">Getting \"there are already some accounts on the device\"?</string>
    <string name="settings_device_owner_troubleshoot_body">Some apps (Instagram, WhatsApp, Signal…) register hidden accounts that never show up in Android\'s account settings. List every account on the device with:</string>
    <string name="settings_device_owner_troubleshoot_fix">In the output, each account\'s \"type\" names the app that owns it. Uninstall that app (or clear its storage), reboot, and run the setup command again. Extra users and work profiles count too — remove them as well. Once Warden Mode is active, reinstall and sign back in to everything.</string>
    <string name="settings_device_owner_testonly_warning">This build was deployed from Android Studio and is marked test-only \u2014 Android allows removing test-only device owners, so uninstall protection is NOT active. Install with adb (gradlew assembleDebug) for full protection.</string>
    <string name="settings_device_owner_remove">Remove Warden Mode</string>
    <string name="settings_device_owner_remove_request">Request Warden removal</string>
    <string name="settings_device_owner_remove_pending">Warden removal unlocks in %1$s</string>
    <string name="settings_device_owner_remove_cancel_request">Cancel removal request</string>
    <string name="settings_device_owner_request_confirm_title">Request Warden removal?</string>
    <string name="settings_device_owner_request_confirm_message">A 24-hour cooling-off period starts now. Once it passes, you can remove Warden Mode from here — or cancel the request at any time if the urge passes first.</string>
    <string name="settings_device_owner_request_confirm_yes">Start the clock</string>
    <string name="settings_device_owner_remove_desc">Ends uninstall protection and app greying. Removal must be requested 24 hours in advance and isn\'t available during a focus session.</string>
    <string name="settings_device_owner_remove_confirm_title">Remove Warden Mode?</string>
    <string name="settings_device_owner_remove_confirm_message">FocusPocus will stop greying out blocked apps and can then be uninstalled like any other app. Getting protection back requires running the adb command again.</string>
    <string name="settings_device_owner_remove_confirm_yes">Remove</string>
    <string name="settings_device_owner_remove_failed">Could not remove device owner protection</string>
    <string name="device_admin_label">FocusPocus Warden</string>
    <string name="device_admin_description">Greys out blocked apps during focus sessions and protects FocusPocus from being uninstalled.</string>
    <string name="device_admin_disable_warning">Disabling this lets blocked apps run freely during focus sessions and makes FocusPocus easy to uninstall. Your future self might not thank you.</string>
    <string name="device_admin_support_short">This app is behind the Focus Pocus Mana Well.</string>
    <string name="device_admin_support_long">This app stays closed until you make a pact. Open Focus Pocus, find it on the Well tab, and tap it under Request time.</string>
